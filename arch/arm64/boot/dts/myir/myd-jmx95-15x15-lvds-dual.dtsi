/ {
	backlight_lvds_dual: backlight-lvds-dual {
		compatible = "pwm-backlight";
		pwms = <&tpm5 1 4000000 0>;
		brightness-levels = <0 45 63 88 119 158 203 255>;
		default-brightness-level = <6>;
	};

	panel_lvds_dual: panel-lvds-dual {
		compatible = "panel-lvds";
		backlight = <&backlight_lvds_dual>;
		width-mm = <154>;
		height-mm = <85>;
		data-mapping = "vesa-24";
		panel-timing {
			clock-frequency = <90000000>;
			hactive = <1280>;
			hfront-porch = <180>;
			hsync-len = <28>;
			hback-porch = <200>;

			vactive = <1024>;
			vfront-porch = <5>;
			vsync-len = <6>;
			vback-porch = <39>;
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dual-lvds-odd-pixels;
				panel_in_odd: endpoint {
					remote-endpoint = <&lvds0_out>;
				};
			};

			port@1 {
				reg = <1>;
				dual-lvds-even-pixels;
				panel_in_even: endpoint {
					remote-endpoint = <&lvds1_out>;
				};
			};
		};
	};
};

&gpio2 {
	lvds1-gpio2-io0-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		status = "okay";
	};
	dual-lvds-gpio2-io18-hog {
		gpio-hog;
		gpios = <18 GPIO_ACTIVE_HIGH>;
		output-high;
		status = "okay";
	};
};

&lpi2c2 {
	status = "okay";
	exp_gpio: gpio@20 {
		dual-lvds-eio-p05-hog {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_HIGH>;
			output-high;
			status = "okay";
		};
		lvds1-eio-p12-hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-low;
			status = "okay";
		};
	};
};

&tpm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm5>;
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
		<&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
		<&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <4008000000>, <445333334>;
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	assigned-clocks = <&scmi_clk IMX95_CLK_LDBPLL_VCO>,
			  <&scmi_clk IMX95_CLK_LDBPLL>;
	assigned-clock-rates = <3291120000>, <1097040000>;
	status = "okay";

	channel@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds0_out: endpoint {
				remote-endpoint = <&panel_in_odd>;
			};
		};
	};

	channel@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <1>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds1_out: endpoint {
				remote-endpoint = <&panel_in_even>;
			};
		};
	};
};

&ldb0_phy {
	status = "okay";
};

&ldb1_phy {
	status = "okay";
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;
	pinctrl_hog: hoggrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO00__GPIO2_IO_BIT0    0x31e
			IMX95_PAD_GPIO_IO18__GPIO2_IO_BIT18    0x31e
		>;
	};

	pinctrl_tpm5: tpm5grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO22__TPM5_CH1    0x51e
		>;
	};
};
