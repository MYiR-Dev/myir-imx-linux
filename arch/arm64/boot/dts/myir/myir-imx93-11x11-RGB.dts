&media_blk_ctrl {
	status = "okay";
};

// &lt9611_hdmi {
// 	status = "disabled";
// };

/* pin conflicts */
&lpuart6{
	status = "disabled";
};

&lpuart3{
	status = "disabled";
};
&lpuart8{
	status = "disabled";
};
