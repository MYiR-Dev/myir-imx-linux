// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright 2024 MYIR Technology Co., Ltd.
 *
 * MYD-JS8MPQ with the MIPI DSI panel (MYIR mipi101c) instead of LVDS.
 *
 * Display path: lcdif1 -> Samsung DSIM -> MYIR MIPI101C panel.
 * The panel uses 1200x1920 sync-pulse video mode at 165.2 MHz.
 *
 * DSI mux selection (both HIGH, opposite of LVDS1):
 *   - core module SEL2 = PCA9555 EIO_P12 (gpio_expander line 10)
 *   - baseboard select = GPIO4_IO21 (SAI2_RXFS pad)
 * Panel reset: XSPI_DATA4 = SAI5_RXD3/GPIO3_IO24, controlled by the panel.
 * Backlight: PWM2 + enable GPIO5_IO29 (same FPC pins as LVDS1).
 * Touch: Goodix GT911 @0x14 on I2C4 (INT=GPIO1_IO00, RST=GPIO1_IO06).
 */

#include "myd-js8mpq.dts"

/ {
	model = "MYIR MYD-JS8MPQ board (DSI panel)";

	/* DSI panel backlight (PWM2 dimming + enable GPIO5_IO29). */
	dsi_backlight: backlight-dsi {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 100000 0>;
		brightness-levels = <0 8 16 32 48 64 80 96 112 128
				     144 160 176 192 208 224 240 255>;
		default-brightness-level = <14>;
		enable-gpios = <&gpio5 29 GPIO_ACTIVE_HIGH>;
	};

	/* Panel supplies: needed by panel-myir-mipi101c driver probe.
	 * Always-on regulators. */
	reg_dsi_v3p3: regulator-dsi-v3p3 {
		compatible = "regulator-fixed";
		regulator-name = "dsi-v3p3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_dsi_v1p8: regulator-dsi-v1p8 {
		compatible = "regulator-fixed";
		regulator-name = "dsi-v1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* HDMI audio machine device is not used by the DSI-only variant. */
	sound-hdmi {
		status = "disabled";
	};
};

/* ========== Disable LVDS display path ========== */
&lcdif2 {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_lvds_ch0 {
	/delete-property/ remote-endpoint;
};

&panel_in_lvds {
	/delete-property/ remote-endpoint;
};

&panel_lvds {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&lvds_backlight {
	status = "disabled";
};

/* Remove LVDS0 baseboard path select hog. */
&gpio1 {
	/delete-node/ lvds0-sel-hog;
};

/* DSI B/DSI1 panel reset pin: XSPI_DATA4 = SAI5_RXD3/GPIO3_IO24. */
&gpio3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dsi_panel_reset>;
};


/* ========== Disable the complete HDMI video/audio chain ========== */
&hdmi_blk_ctrl {
	status = "disabled";
};

&irqsteer_hdmi {
	status = "disabled";
};

&hdmi_pavi {
	status = "disabled";
};

&hdmiphy {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

&lcdif3 {
	status = "disabled";
};

&aud2htx {
	status = "disabled";
};

/* ========== Enable DSI host with panel ========== */
&lcdif1 {
	/* Generate the 165.2 MHz pixel clock exactly from 991.2 MHz / 6. */
	assigned-clocks = <&clk IMX8MP_VIDEO_PLL1>,
			  <&clk IMX8MP_CLK_MEDIA_DISP1_PIX>,
			  <&clk IMX8MP_CLK_MEDIA_AXI>,
			  <&clk IMX8MP_CLK_MEDIA_APB>;
	assigned-clock-parents = <0>,
				 <&clk IMX8MP_VIDEO_PLL1_OUT>,
				 <&clk IMX8MP_SYS_PLL2_1000M>,
				 <&clk IMX8MP_SYS_PLL1_800M>;
	assigned-clock-rates = <991200000>, <165200000>,
			       <500000000>, <200000000>;
	status = "okay";
};

&mipi_dsi {
	status = "okay";

	panel@0 {
		compatible = "myir,mipi101c-imx8mp";
		reg = <0>;
		dsi-lanes = <4>;
		/* 0: burst, 1: sync-event, 2: sync-pulse. */
		video-mode = <2>;
		panel-width-mm = <135>;
		panel-height-mm = <216>;
		backlight = <&dsi_backlight>;
		reset-gpios = <&gpio3 24 GPIO_ACTIVE_LOW>;
		v3p3-supply = <&reg_dsi_v3p3>;
		v1p8-supply = <&reg_dsi_v1p8>;

		/* Standard physical size used by the DT panel-timing parser. */
		width-mm = <135>;
		height-mm = <216>;

		/*
		 * Keep the 260-pixel horizontal blanking total while providing
		 * enough HSA and HBP space for sync-pulse packet overhead.
		 */
		panel-timing {
			clock-frequency = <165200000>;
			hactive = <1200>;
			hfront-porch = <228>;
			hsync-len = <12>;
			hback-porch = <20>;
			vactive = <1920>;
			vfront-porch = <3>;
			vsync-len = <1>;
			vback-porch = <5>;
			hsync-active = <0>;
			vsync-active = <0>;
		};
	};
};

/* ========== DSI mux selection (both HIGH to select DSI path) ========== */

/* Core-module SEL2 = EIO_P12 = GPIO line 10. HIGH = DSI. */
&gpio_expander {
	dsi-sel2-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "dsi_sel2";
	};
};

/* Baseboard select = GPIO4_IO21. HIGH = DSI. */
&gpio4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdt_en &pinctrl_dsi_sel>;

	dsi-sel-hog {
		gpio-hog;
		gpios = <21 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "dsi_sel";
	};
};

/* ========== Backlight: PWM2 dimming + GPIO5_IO29 enable ========== */
&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm2>;
	status = "okay";
};

&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dsi_bl_en>;
};

/* ========== Touch: Goodix GT911 @0x14 on I2C4 ========== */
&lvds_touch {
	status = "disabled";
};

&i2c4 {
	dsi_touch: touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_touch_dsi>;
		interrupt-parent = <&gpio1>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
		esd-recovery-timeout-ms = <2000>;	/* match i.MX95 MYD same-panel ref */
		touchscreen-size-x = <1200>;
		touchscreen-size-y = <1920>;
	};
};

/* ========== Pinmux additions ========== */
&iomuxc {
	pinctrl_dsi_panel_reset: dsipanelresetgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI5_RXD3__GPIO3_IO24	0x140
		>;
	};

	pinctrl_pwm2: pwm2grp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO11__PWM2_OUT	0x116
		>;
	};

	pinctrl_dsi_sel: dsiselgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI2_RXFS__GPIO4_IO21	0x140
		>;
	};

	pinctrl_dsi_bl_en: dsiblengrp {
		fsl,pins = <
			MX8MP_IOMUXC_UART4_TXD__GPIO5_IO29	0x140
		>;
	};

	pinctrl_touch_dsi: touchdsigrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO00__GPIO1_IO00	0x1c0
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06	0x1c0
		>;
	};
};
