/*
 * MYD-JS8MPQ 2GB DDR variant with native HDMI and a MAX96722 on the
 * physical CSI1 connector.
 *
 * The GMSL adapter reuses the OV5640 CSI1 input on this carrier:
 *
 *   GMSL cameras -> MAX96722 -> mipi_csi_1 -> isi_1
 *
 * This follows the NVP6324/N4 single-output model used by the 6.18 BSP.  All
 * four ALI360-YH links are initialized, but the MAX96722 exposes only the
 * selected camera on VC0.  The active input is switched at runtime through
 * the MAX96722 driver's active_camera attribute.
 */

#include "myd-js8mpq.dts"
#include "myd-js8mpq-2g-memory.dtsi"

/ {
	model = "MYIR MYD-JS8MPQ board (HDMI + CSI1 MAX96722)";

	/* GPIO4_IO01 is CSI1 PWDN/ENABLE and must be high before I2C access. */
	reg_max96722_enable: regulator-max96722-enable {
		compatible = "regulator-fixed";
		regulator-name = "max96722-enable";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		gpio = <&gpio4 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

/* HDMI is inherited from the base DTS; remove the simultaneous LVDS path. */
&lcdif2 {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_lvds_ch0 {
	/delete-property/ remote-endpoint;
};

&panel_in_lvds {
	/delete-property/ remote-endpoint;
};

&panel_lvds {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&lvds_backlight {
	status = "disabled";
};

&lvds_touch {
	status = "disabled";
};

&gpio1 {
	/delete-node/ lvds0-sel-hog;
};

/* Replace the base OV5640 path on mipi_csi_1 with the MAX96722. */
&ov5640_0 {
	status = "disabled";
};

&ov5640_0_ep {
	/delete-property/ remote-endpoint;
};

&i2c3 {
	clock-frequency = <100000>;

	/*
	 * NCA9555 on the GMSL adapter board.  P00 drives the MAX20087 EN
	 * input through R73; R75 otherwise pulls EN low and disables all
	 * four PoC outputs.  The CPU MIPI_CSI_PWREN alternative is DNP.
	 */
	gmsl_gpio: gpio@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		poc-enable-hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "gmsl-poc-enable";
		};
	};

	max96722: deserializer@6b {
		compatible = "maxim,max96722";
		reg = <0x6b>;
		status = "okay";
		maxim,allow-no-link;
		maxim,ali360-yh-profile;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi1>;
		rst-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
		v12p0-supply = <&reg_max96722_enable>;

		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_a_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96717_a_gmsl_out>;
				};

				max96722_pipe_0_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_0>;
				};
			};

			port@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_b_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96717_b_gmsl_out>;
				};

				max96722_pipe_1_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_1>;
				};
			};

			port@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_c_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96717_c_gmsl_out>;
				};

				max96722_pipe_2_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_2>;
				};
			};

			port@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_d_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96717_d_gmsl_out>;
				};

				max96722_pipe_3_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_3>;
				};
			};

			port@4 {
				reg = <4>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_csi_in_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96722_pipe_0_out>;
				};

				max96722_csi_in_1: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_pipe_1_out>;
				};

				max96722_csi_in_2: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&max96722_pipe_2_out>;
				};

				max96722_csi_in_3: endpoint@3 {
					reg = <3>;
					remote-endpoint = <&max96722_pipe_3_out>;
				};

				max96722_csi1_out: endpoint@4 {
					reg = <4>;
					/*
					 * The carrier exposes four lanes, but this board/adapter
					 * combination is electrically validated with PHY0's two
					 * lanes.  Four-lane mode produces an ECC error on nearly
					 * every CSI-2 long-packet header.
					 */
					data-lanes = <1 2>;
					clock-lanes = <0>;
					remote-endpoint = <&mipi_csi1_in>;
				};
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				max96717_a: serializer@40 {
					compatible = "maxim,max96717", "maxim,max96717f";
					reg = <0x40>;
					status = "okay";
					maxim,ali360-yh-profile;
					gpio-controller;
					#gpio-cells = <2>;
					#clock-cells = <0>;

					ports {
						#address-cells = <1>;
						#size-cells = <0>;

						port@0 {
							reg = <0>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_a_csi_in: endpoint@0 {
								reg = <0>;
								data-lanes = <1 2 3 4>;
							};
						};

						port@1 {
							reg = <1>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_a_gmsl_out: endpoint@0 {
								reg = <0>;
								remote-endpoint = <&max96722_gmsl_a_in>;
							};
						};
					};
				};
			};

			i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				max96717_b: serializer@40 {
					compatible = "maxim,max96717", "maxim,max96717f";
					reg = <0x40>;
					status = "okay";
					maxim,ali360-yh-profile;
					gpio-controller;
					#gpio-cells = <2>;
					#clock-cells = <0>;

					ports {
						#address-cells = <1>;
						#size-cells = <0>;

						port@0 {
							reg = <0>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_b_csi_in: endpoint@0 {
								reg = <0>;
								data-lanes = <1 2 3 4>;
							};
						};

						port@1 {
							reg = <1>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_b_gmsl_out: endpoint@0 {
								reg = <0>;
								remote-endpoint = <&max96722_gmsl_b_in>;
							};
						};
					};
				};
			};

			i2c@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				max96717_c: serializer@40 {
					compatible = "maxim,max96717", "maxim,max96717f";
					reg = <0x40>;
					status = "okay";
					maxim,ali360-yh-profile;
					gpio-controller;
					#gpio-cells = <2>;
					#clock-cells = <0>;

					ports {
						#address-cells = <1>;
						#size-cells = <0>;

						port@0 {
							reg = <0>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_c_csi_in: endpoint@0 {
								reg = <0>;
								data-lanes = <1 2 3 4>;
							};
						};

						port@1 {
							reg = <1>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_c_gmsl_out: endpoint@0 {
								reg = <0>;
								remote-endpoint = <&max96722_gmsl_c_in>;
							};
						};
					};
				};
			};

			i2c@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				max96717_d: serializer@40 {
					compatible = "maxim,max96717", "maxim,max96717f";
					reg = <0x40>;
					status = "okay";
					maxim,ali360-yh-profile;
					gpio-controller;
					#gpio-cells = <2>;
					#clock-cells = <0>;

					ports {
						#address-cells = <1>;
						#size-cells = <0>;

						port@0 {
							reg = <0>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_d_csi_in: endpoint@0 {
								reg = <0>;
								data-lanes = <1 2 3 4>;
							};
						};

						port@1 {
							reg = <1>;
							#address-cells = <1>;
							#size-cells = <0>;

							max96717_d_gmsl_out: endpoint@0 {
								reg = <0>;
								remote-endpoint = <&max96722_gmsl_d_in>;
							};
						};
					};
				};
			};
		};
	};
};

&cameradev {
	status = "okay";
};

&mipi_csi_0 {
	status = "disabled";
};

&mipi_csi_1 {
	status = "okay";
	maxim,max96717-chain;
};

/* Reuse the base DTS' physical CSI1 endpoint; OV5640 is disabled above. */
&mipi_csi1_in {
	remote-endpoint = <&max96722_csi1_out>;
	data-lanes = <2>;
	clock-lanes = <0>;
	/* Preserve the previously validated two-lane receiver timing. */
	csis-hs-settle = <10>;
	csis-clk-settle = <2>;
	csis-wclk;
};

&isi_0 {
	status = "disabled";

	cap_device {
		status = "disabled";
	};
};

&isi_1 {
	status = "okay";
	interface = <3 0 2>;

	cap_device {
		status = "okay";
	};
};
