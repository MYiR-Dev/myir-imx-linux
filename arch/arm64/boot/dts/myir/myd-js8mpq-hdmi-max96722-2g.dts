/*
 * MYD-JS8MPQ 2GB DDR variant with native HDMI and a MAX96722 on the
 * physical CSI1 connector.
 *
 * The MYD CSI1 connector is wired to the first i.MX8MP CSI receiver:
 *
 *   GMSL cameras -> MAX96722 -> mipi_csi_0 -> isi_0
 *
 * The four-link topology follows the NXP MAX9286 CSI1 reference overlay.
 * Remote buses are disabled for deserializer-only bring-up and can be enabled
 * after the actual serializers and sensors are connected and identified.
 */

#include "myd-js8mpq.dts"
#include "myd-js8mpq-2g-memory.dtsi"

/ {
	model = "MYIR MYD-JS8MPQ board (HDMI + CSI1 MAX96722)";

	/* GPIO4_IO01 is CSI1 PWDN/ENABLE and must be high before I2C access. */
	reg_max96722_enable: regulator-max96722-enable {
		compatible = "regulator-fixed";
		regulator-name = "max96722-enable";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		gpio = <&gpio4 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

/* HDMI is inherited from the base DTS; remove the simultaneous LVDS path. */
&lcdif2 {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_lvds_ch0 {
	/delete-property/ remote-endpoint;
};

&panel_in_lvds {
	/delete-property/ remote-endpoint;
};

&panel_lvds {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&lvds_backlight {
	status = "disabled";
};

&lvds_touch {
	status = "disabled";
};

&gpio1 {
	/delete-node/ lvds0-sel-hog;
};

/* The base CSI0 OV5640 path is not populated in this camera variant. */
&ov5640_0 {
	status = "disabled";
};

&ov5640_0_ep {
	/delete-property/ remote-endpoint;
};

&mipi_csi_1 {
	status = "disabled";
};

&mipi_csi1_in {
	/delete-property/ remote-endpoint;
};

&isi_1 {
	status = "disabled";

	cap_device {
		status = "disabled";
	};
};

&i2c3 {
	clock-frequency = <100000>;

	max96722: deserializer@6b {
		compatible = "maxim,max96722";
		reg = <0x6b>;
		status = "okay";
		maxim,allow-no-link;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi1>;
		rst-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
		v12p0-supply = <&reg_max96722_enable>;

		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_a_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rdacm20_csi1_out0>;
				};

				max96722_pipe_0_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_0>;
				};
			};

			port@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_b_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rdacm20_csi1_out1>;
				};

				max96722_pipe_1_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_1>;
				};
			};

			port@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_c_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rdacm20_csi1_out2>;
				};

				max96722_pipe_2_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_2>;
				};
			};

			port@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_gmsl_d_in: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rdacm20_csi1_out3>;
				};

				max96722_pipe_3_out: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_csi_in_3>;
				};
			};

			port@4 {
				reg = <4>;
				#address-cells = <1>;
				#size-cells = <0>;

				max96722_csi_in_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&max96722_pipe_0_out>;
				};

				max96722_csi_in_1: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&max96722_pipe_1_out>;
				};

				max96722_csi_in_2: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&max96722_pipe_2_out>;
				};

				max96722_csi_in_3: endpoint@3 {
					reg = <3>;
					remote-endpoint = <&max96722_pipe_3_out>;
				};

				max96722_csi1_out: endpoint@4 {
					reg = <4>;
					data-lanes = <1 2 3 4>;
					clock-lanes = <0>;
					remote-endpoint = <&mipi_csi0_in>;
				};
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";

				camera@51 {
					compatible = "imi,rdacm20";
					reg = <0x51>, <0x61>;
					imi,no-poc;

					port {
						rdacm20_csi1_out0: endpoint {
							remote-endpoint = <&max96722_gmsl_a_in>;
						};
					};
				};
			};

			i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";

				camera@52 {
					compatible = "imi,rdacm20";
					reg = <0x52>, <0x62>;
					imi,no-poc;

					port {
						rdacm20_csi1_out1: endpoint {
							remote-endpoint = <&max96722_gmsl_b_in>;
						};
					};
				};
			};

			i2c@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";

				camera@53 {
					compatible = "imi,rdacm20";
					reg = <0x53>, <0x63>;
					imi,no-poc;

					port {
						rdacm20_csi1_out2: endpoint {
							remote-endpoint = <&max96722_gmsl_c_in>;
						};
					};
				};
			};

			i2c@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";

				camera@54 {
					compatible = "imi,rdacm20";
					reg = <0x54>, <0x64>;
					imi,no-poc;

					port {
						rdacm20_csi1_out3: endpoint {
							remote-endpoint = <&max96722_gmsl_d_in>;
						};
					};
				};
			};
		};
	};
};

&cameradev {
	status = "okay";
};

&mipi_csi_0 {
	status = "okay";
	virtual-channel;

	port {
		mipi_csi0_in: endpoint {
			remote-endpoint = <&max96722_csi1_out>;
			data-lanes = <4>;
			clock-lanes = <0>;
			csis-hs-settle = <10>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};

&isi_0 {
	status = "okay";

	cap_device {
		status = "okay";
	};
};
