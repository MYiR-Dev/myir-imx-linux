#include "imx95-clock.h"
#include <dt-bindings/gpio/gpio.h>
#include "imx95-pinfunc.h"

/ {
	backlight_dsi: backlight-dsi {
		compatible = "pwm-backlight";
		pwms = <&tpm4 2 4000000 0>;
		brightness-levels = <0 45 63 88 119 158 203 255>;
		default-brightness-level = <6>;
	};
};

&gpio2 {
	dsi-gpio2-io0-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-high;
		status = "okay";
	};
};

&lpi2c2 {
	status = "okay";

	exp_gpio: gpio@20 {
		dsi-eio-p11-hog {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_HIGH>;
			output-high;
			status = "okay";
		};

		dsi-eio-p12-hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-high;
			status = "okay";
		};
	};
};

&lpi2c3 {
	status = "okay";
	
	gt911: gt911@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_dsi1_touch>;
		interrupt-parent = <&gpio2>;
		interrupts = <31 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&gpio2 31 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio5 7 GPIO_ACTIVE_HIGH>;
		esd-recovery-timeout-ms = <2000>;
		touchscreen-size-x = <1200>;
		touchscreen-size-y = <1920>;
		status = "okay";
	};
};

&tpm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm4>;
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <4008000000>, <445333334>;
};

&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "myir,mipi101c";
		reg = <0>;
		dsi-lanes = <4>;
		video-mode = <2>;	/* 0: burst mode
					 * 1: non-burst mode with sync event
					 * 2: non-burst mode with sync pulse
					 */
		panel-width-mm = <135>;
		panel-height-mm = <216>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;
	pinctrl_hog: hoggrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO00__GPIO2_IO_BIT0    0x31e
		>;
	};

	pinctrl_tpm4: tpm4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO13__TPM4_CH2    0x51e
		>;
	};

	pinctrl_dsi1_touch: dsi1_touch_grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO31__GPIO2_IO_BIT31    0x31e
			IMX95_PAD_XSPI1_DATA7__GPIO5_IO_BIT7    0x31e
		>;
	};
};
