/ {
	backlight_lvds1: backlight-lvds1 {
		compatible = "pwm-backlight";
		pwms = <&tpm4 2 4000000 0>;
		brightness-levels = <0 45 63 88 119 158 203 255>;
		default-brightness-level = <6>;
	};

	panel_lvds1: panel-lvds1 {
		compatible = "panel-lvds";
		backlight = <&backlight_lvds1>;
		width-mm = <154>;
		height-mm = <85>;
		data-mapping = "vesa-24";
		panel-timing {
			clock-frequency = <50000000>;
			hactive = <1024>;
			hfront-porch = <88>;
			hsync-len = <6>;
			hback-porch = <176>;
			vactive = <600>;
			vfront-porch = <25>;
			vsync-len = <5>;
			vback-porch = <20>;
		};

		port {
			panel_lvds1_in: endpoint {
				remote-endpoint = <&lvds1_out>;
			};
		};
	};
};

&gpio2 {
	lvds1-gpio2-io0-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		status = "okay";
	};
};

&lpi2c2 {
	status = "okay";

	exp_gpio: gpio@20 {
		lvds1-eio-p12-hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-low;
			status = "okay";
		};
	};
};


&lpi2c3 {
	status = "okay";

	ft5x06_ts_1: touchscreen_1@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds1_touch>;
		interrupt-parent = <&gpio2>;
		interrupts = <31 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&exp_gpio 4 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <600>;
		status = "okay";
	};
};

&tpm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm4>;
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	assigned-clocks = <&scmi_clk IMX95_CLK_LDBPLL_VCO>,
			  <&scmi_clk IMX95_CLK_LDBPLL>;
	assigned-clock-rates = <2982000000>, <497000000>;
	status = "okay";

	channel@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <1>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds1_out: endpoint {
				remote-endpoint = <&panel_lvds1_in>;
			};
		};
	};
};

&ldb1_phy {
	status = "okay";
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@1 {
		reg = <1>;
		status = "okay";
	};
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;
	pinctrl_hog: hoggrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO00__GPIO2_IO_BIT0    0x31e
		>;
	};

	pinctrl_tpm4: tpm4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO13__TPM4_CH2    0x51e
		>;
	};

	pinctrl_lvds1_touch: lvds1_touch_grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO31__GPIO2_IO_BIT31    0x31e
		>;
	};
};
